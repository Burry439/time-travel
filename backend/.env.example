# Copy this file to backend/.env and paste your key. backend/.env is git-ignored.
# Restart the backend (tools/stop_m0.ps1, then tools/run_m0.ps1) after changing it.

OPENAI_API_KEY=

# live (default when a key is set) or off
AI_MODE=live

# Judge for Try Something attempts. gpt-6-sol is ~20x pricier and more careful; switch if tests show a need.
MODEL_JUDGE=gpt-6-luna
# none | low | medium | high  (higher = slower, more careful)
JUDGE_REASONING=low

# Voice: in conversation, reads the moment, says what the person says and picks what they do (D-46).
MODEL_VOICE=gpt-6-luna
VOICE_REASONING=none

# Sprite painter. Falls back to MODEL_IMAGE_FALLBACK if the first model is unavailable.
MODEL_IMAGE=gpt-image-2.5-flare
MODEL_IMAGE_FALLBACK=gpt-image-2
# low | medium | high
IMAGE_QUALITY=medium
# on | off
IMAGES=on

# Safety valve on spend: maximum model calls per journey.
MAX_MODEL_CALLS_PER_RUN=200

# Decider: typed questions over code-built options (is a typed line words or a deed; would someone
# in earshot speak up). DECIDER_BACKEND: decisions (OpenAI's Decisions API, falling back once to
# responses) | responses (a strict JSON schema). DECIDER_REASONING applies to responses only:
# none | low | medium | high
MODEL_DECIDER=gpt-6-luna
DECIDER_BACKEND=decisions
DECIDER_REASONING=low

# Before anyone not addressed takes their turn in a conversation, a quick check of their own:
# would they speak up, or does it give them reason to act? on | off (off: everyone takes a turn).
BYSTANDER_GATE=on
