# Copy this file to backend/.env and paste your key. backend/.env is git-ignored.
# Restart the backend (tools/stop_m0.ps1, then tools/run_m0.ps1) after changing it.

OPENAI_API_KEY=

# live (default when a key is set) or off
AI_MODE=live

# Judge for Try Something attempts. gpt-6-sol is ~20x pricier and more careful; switch if tests show a need.
MODEL_JUDGE=gpt-6-luna
# none | low | medium | high  (higher = slower, more careful)
JUDGE_REASONING=low

# Sprite painter. Falls back to MODEL_IMAGE_FALLBACK if the first model is unavailable.
MODEL_IMAGE=gpt-image-2.5-flare
MODEL_IMAGE_FALLBACK=gpt-image-2
# low | medium | high
IMAGE_QUALITY=medium
# on | off
IMAGES=on

# Safety valve on spend: maximum model calls per journey.
MAX_MODEL_CALLS_PER_RUN=200

# Jev decides what NPCs do (notice, feel, choose an action). Either a TypeSafe key (console.typesafe.ai/keys)
# or a defapi.org key (starts with dk-); the gateway is detected from the key. Override with JEV_PROVIDER=defapi|typesafe.
TYPESAFE_API_KEY=
# jev (default when a TypeSafe key is set) | llm (use MODEL_DECIDER instead) 
DECIDER=jev
MODEL_DECIDER=gpt-6-luna
